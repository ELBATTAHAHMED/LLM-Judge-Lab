# ==============================================================================
# LLM-as-a-Judge Reliability Lab — Environment Configuration (.env)
# ==============================================================================

# Database Connection (PostgreSQL or local SQLite fallback)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/judgelab

# OpenAI API Key (Required for GPT-4o / GPT-4o-mini G-EVAL evaluations)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (Required for DeepSeek-V3, Llama-3.3-70B, and Claude-3 Haiku)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Disabled-by-default live demonstration boundary. This token is deliberately
# separate from any controlled-execution authorization.
ENABLE_LIVE_SANDBOX_PROVIDER_CALLS=false
LIVE_SANDBOX_OPERATOR_TOKEN=replace_with_separate_operator_token
JUDGELAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Model Provider Base URL (Optional for Ollama local execution)
OLLAMA_BASE_URL=http://localhost:11434/v1
